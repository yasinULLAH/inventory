# ----------------------------------------------------------------------
# | BNI ENTERPRISES PRODUCTION SECURITY SETTINGS                         |
# ----------------------------------------------------------------------

# 1. Enable SymLinks (Required for RewriteRules) and Disable Directory Listing
Options +SymLinksIfOwnerMatch -Indexes

# 1b. Fallback to hide all files from directory listing (if -Indexes is ignored)
IndexIgnore *

# 2. Block access to hidden files, backups, and config formats safely
<FilesMatch "\.(env|sql|log|ini|sh|bak|json|md|git)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Security Response Headers
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # Basic CSP - Restricts inline execution slightly while allowing CDNs currently in use
    Header set Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://code.jquery.com https://unpkg.com; img-src 'self' data: blob:;"
</IfModule>

# 4. Prevent Execution of Scripts inside the uploads directory safely
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^uploads/.*\.(php|php[3-8]|phtml|pl|py|jsp|asp|sh|cgi)$ -[F,L,NC]
</IfModule>