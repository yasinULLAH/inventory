# ----------------------------------------------------------------------
# | BNI ENTERPRISES PRODUCTION SECURITY SETTINGS                         |
# ----------------------------------------------------------------------

# 1. Enable SymLinks (Required for RewriteRules) and Disable Directory Listing
Options +SymLinksIfOwnerMatch -Indexes

# 1b. Fallback to hide all files from directory listing (if -Indexes is ignored)
IndexIgnore *

# 2. Block access to hidden files, backups, and config formats safely
<FilesMatch "\.(env|sql|log|ini|sh|bak|json|md|git)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Security Response Headers
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    # X-Frame-Options is removed here because Content-Security-Policy "frame-ancestors" is more flexible and modern.
    # Setting it to SAMEORIGIN was blocking the Google Maps iframe from within your own site.
    Header unset X-Frame-Options
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Modern Content-Security-Policy
    # frame-src: Allows Google Maps embed
    # img-src: Allows self and data (for Three.js/Icons)
    # connect-src: Allows self (for any AJAX/API calls)
    Header set Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://code.jquery.com https://unpkg.com https://cdn.datatables.net https://fonts.googleapis.com https://fonts.gstatic.com; img-src 'self' data: blob: https://cdn.datatables.net https://via.placeholder.com; frame-src 'self' https://www.google.com https://maps.google.com; connect-src 'self';"
</IfModule>

# 4. Prevent Execution of Scripts inside the uploads directory safely
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^uploads/.*\.(php|php[3-8]|phtml|pl|py|jsp|asp|sh|cgi)$ -[F,L,NC]
</IfModule>